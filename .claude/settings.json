{
  "permissions": {
    "allow": [
      "Bash(python3 -m pytest *)",
      "Bash(docker compose logs *)",
      "Bash(docker compose ps)",
      "Bash(docker compose ps *)",
      "Bash(docker info)",
      "Bash(docker info *)",
      "Bash(dig *)",
      "mcp__Claude_Browser__navigate",
      "mcp__Claude_Browser__read_page",
      "mcp__Claude_Browser__get_page_text",
      "mcp__Claude_Browser__find",
      "mcp__Claude_Browser__read_network_requests",
      "mcp__Claude_Browser__read_console_messages",
      "mcp__Claude_Browser__resize_window"
    ],
    "deny": [
      "Read(./.env)",
      "Edit(./.env)",
      "Write(./.env)",
      "Read(./.env.bak*)",
      "Edit(./.env.bak*)",
      "Write(./.env.bak*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/block-env-access.sh\"",
            "timeout": 10,
            "statusMessage": "Checking for .env access"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/run-tests-on-app-edit.sh\"",
            "timeout": 120,
            "asyncRewake": true,
            "rewakeSummary": "pytest failed after an app/ edit",
            "statusMessage": "Running tests"
          }
        ]
      }
    ]
  }
}
