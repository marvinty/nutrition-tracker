ANTHROPIC_API_KEY=your-anthropic-key-here

# Required: speech-to-text always goes through OpenAI Whisper, whatever LLM_PROVIDER is.
OPENAI_API_KEY=your-openai-key-here

LLM_PROVIDER=claude

# Whisper: "openai" is the only provider the image can actually run — the local one's
# dependencies (torch, openai-whisper) are not installed. Leave this alone.
WHISPER_PROVIDER=openai
# Local model size: tiny | base | small | medium | large. Unused while WHISPER_PROVIDER=openai.
WHISPER_MODEL=base

# Cost protection: daily AI credit budget per user, by tier. A user's tier lives in
# the DB (default "free"); there is no billing yet, so promote by hand with
#   sqlite3 macromic.db "UPDATE user SET tier='pro' WHERE username='...'"
TIER_DAILY_CREDITS={"free": 20, "pro": 300}
# What each action costs. Voice is dearer because it pays for transcription *and*
# the LLM analysis that follows. A clarifying round is free: the model asked the
# question, so charging for the answer would penalise the user for its uncertainty.
CREDIT_COSTS={"text": 1, "clarify": 0, "voice": 3}
# App-wide ceiling across all users — the circuit breaker against a runaway bill.
# Set it well above normal daily usage; if it trips, everyone is locked out until
# local midnight, which is the deliberate trade.
GLOBAL_DAILY_CREDITS=500

# Invite code required to register. LEAVE EMPTY ONLY FOR LOCAL DEV — an open signup
# lets anyone create accounts and spend your API budget. The app logs a warning at
# startup while this is unset.
SIGNUP_CODE=

# Transactional mail (Bestätigung, Passwort-Reset) über Resend. Ohne Key werden
# Mails NICHT verschickt, sondern samt Link ins Log geschrieben — genau richtig für
# lokale Entwicklung, aber in Produktion kommt dann keine Bestätigung an.
RESEND_API_KEY=
# Muss eine bei Resend verifizierte Domain sein, sonst landet alles im Spam.
EMAIL_FROM=MacroMic <noreply@example.com>
# Wie lange ein neues Konto unbestätigt nutzbar ist, bevor es gesperrt wird. Die
# Sperre lässt sich von der Sperrseite aus selbst aufheben.
EMAIL_VERIFY_GRACE_MINUTES=60
# Öffentliche Basis-URL für die Links in den Mails. Hinter einem Reverse Proxy MUSS
# das gesetzt sein, sonst zeigen die Links auf die interne Adresse.
PUBLIC_BASE_URL=http://localhost:8000

# Impressum (§5 DDG) und Verantwortlicher (Art. 4 Nr. 7 DSGVO). Steht bewusst hier und
# nicht im Template: das Repo ist öffentlich, und eine Privatanschrift bekommt man aus
# der Git-Historie nicht mehr heraus. Solange die Felder leer sind, zeigen /impressum
# und /datenschutz einen roten Platzhalter statt einer Adresse.
IMPRINT_NAME=
IMPRINT_STREET=
IMPRINT_CITY=
IMPRINT_EMAIL=

APP_PORT=8000
DATABASE_URL=sqlite+aiosqlite:////data/macromic.db

# Set to true when serving over HTTPS, so session cookies get the Secure flag
COOKIE_SECURE=false

# Wie viele eigene Reverse Proxies vor der App stehen. Entscheidet, welchem Eintrag
# von X-Forwarded-For die Rate-Limits vertrauen. 0 = kein Proxy (Header wird komplett
# ignoriert, weil ihn dann jeder Client frei setzen könnte). Hinter Caddy/nginx/
# Traefik auf 1 setzen — sonst kann sich ein Angreifer pro Request eine neue IP
# ausdenken und alle Limits unten sind wirkungslos.
TRUSTED_PROXY_HOPS=1

# Fehlversuche pro Zeitfenster, gezählt pro IP UND pro Konto. Nur Fehlschläge zählen,
# normale Nutzung läuft also nie hinein.
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_MINUTES=15
# Registrierungen und Passwort-Mails pro IP und Fenster — hier zählt jeder Versuch,
# weil bei diesen beiden der Erfolg das Problem ist (Massenaccounts, Mail-Flut).
SIGNUP_RATE_LIMIT=5
FORGOT_PASSWORD_RATE_LIMIT=5

# Admin panel at /admin. Both values must be set for the admin to be created on
# startup; if the account already exists its password is reset to this value.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- NICHT hierher: HETZNER_CLOUD_API_TOKEN ---
# Das Token für die hetzner-ddns-* Container (A-Records app/root/www auf die aktuelle
# IPv4) gehört in eine eigene Datei `.env.ddns` neben dieser hier, NICHT in `.env`:
#
#   HETZNER_CLOUD_API_TOKEN=<token aus console.hetzner.com, Security -> API Tokens,
#                            mit DNS-Lese- und Schreibrecht>
#
# Grund: der api-Service lädt `.env` per `env_file` komplett in seinen Prozess, und
# Settings in app/core/config.py verbietet unbekannte Keys (pydantic `extra="forbid"`).
# Ein Key hier, den die App nicht kennt, killt sie beim Import — und zwar erst beim
# nächsten Recreate des Containers, nicht beim Eintragen. Genau so ist Prod am
# 2026-08-02 hochgegangen. docker-compose.prod.yml zieht `.env.ddns` direkt.
